# FED-LINk environment template.
#
# Copy to .env and fill in only what you use. .env is gitignored —
# never commit real credentials (see SECURITY.md).
#
#   cp .env.example .env
#
# Values below are the project defaults; anything optional is marked.
# The generator core needs NONE of these — this file exists for the
# deployment tooling (ROADMAP v1.2 FTP/SFTP deploy) and CI mirrors
# (deploy.yml reads GitHub variables/secrets, not this file).

# --- Site identity (defaults of the CLI flags; change if you fork) ---
FEDLINK_SITE_DOMAIN=link.fedpromptly.com
FEDLINK_HOME_URL=https://fedpromptly.com

# --- Build locations ---
FEDLINK_LINKS_FILE=configs/links.json
FEDLINK_OUTPUT_DIR=output
FEDLINK_ZIP_NAME=links.zip

# --- Mirror deploy (optional; used by deploy.yml via GitHub vars) ---
# The workflow reads these from repository Variables/Secrets, not from
# .env; listed here so operators know the full set.
# DEPLOY_MIRROR_URL=https://mirror.example.com/upload
# DEPLOY_MIRROR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- FTP deploy (optional; ROADMAP v1.2 — reserved, not yet wired) ---
# FEDLINK_FTP_HOST=ftpupload.net
# FEDLINK_FTP_USER=if0_41564609
# FEDLINK_FTP_PASS=
# FEDLINK_FTP_DIR=/link.fedpromptly.com/htdocs

# --- InfinityFree host details (optional; reference for operators) ---
INFINITYFREE_PANEL_URL=https://app.infinityfree.com
INFINITYFREE_SERVER=if0_41564609.epizy.com
INFINITYFREE_SUBDOMAIN=link.fedpromptly.com
