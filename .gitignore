# FED-LINk .gitignore
#
# Principles: generated artifacts are disposable (ADR-0009 — clean-first
# generation; the host is never state), secrets never land in git, and
# the .keep files that anchor empty tree directories survive.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/lib/
wheels/
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Test / coverage artifacts ---
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- FED-LINk generated artifacts (disposable, rebuilt in seconds) ---
output/*
!output/.keep
links.zip

# --- Packaging outputs (keep the .keep anchors) ---
build/*
!build/.keep
dist/*
!dist/.keep
bin/
.buildozer/

# --- Logs (keep the .keep anchor) ---
logs/*
!logs/.keep
*.log

# --- Secrets (use .env.example as the template) ---
.env
.env.*
!.env.example

# --- Editors / OS ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Misc scratch ---
*.tmp
*.bak
.cache/
